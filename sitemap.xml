---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign documents = site.pages | concat: site.posts | concat: site.papers %}
{% for document in documents %}
  {% assign extension = document.url | split: '.' | last %}
  {% assign last_character = document.url | slice: -1, 1 %}
  {% unless document.sitemap == false or document.sitemap.exclude == 'yes' or document.robots contains 'noindex' or document.published == false %}
    {% if last_character == '/' or extension == 'html' %}
  <url>
    <loc>{{ document.url | replace: 'index.html', '' | absolute_url | xml_escape }}</loc>
    {% if document.last_modified_at %}<lastmod>{{ document.last_modified_at | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
    {% endif %}
  {% endunless %}
{% endfor %}
</urlset>
